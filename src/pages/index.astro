            </a>
          ))}
        </div>
        <div style="margin-top: var(--s-6);">
          <a class="btn btn--secondary" href="/blog/">See all {posts.length} articles</a>
        </div>
      </div>
      <div class="span-6 start-7">
        <div class="frame frame--photo">
          <img
            src="/assets/images/usb2ip/raspberry_ble.jpg"
            alt="Raspberry Pi hardware setup for Docker and Bluetooth over IP"
            width="1280"
            height="960"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const img = document.getElementById('hero-portrait-src');
      const canvas = document.getElementById('matrix-portrait');
      if (!(img instanceof HTMLImageElement) || !(canvas instanceof HTMLCanvasElement)) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const GLYPHS = '01アイウエオカキクケコサシスセソタチツテト';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cell = 7;
      let cols = 0;
      let rows = 0;
      let grid = [];
      let drops = [];
      let rafId = 0;
      let lastTick = 0;

      function samplePortrait() {
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height || !img.naturalWidth) return;

        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        cols = Math.ceil(rect.width / cell);
        rows = Math.ceil(rect.height / cell);

        const off = document.createElement('canvas');
        off.width = cols;
        off.height = rows;
        const octx = off.getContext('2d');
        if (!octx) return;

        // object-fit: cover with object-position: 82% 20%
        const imgAspect = img.naturalWidth / img.naturalHeight;
        const boxAspect = cols / rows;
        let sx = 0, sy = 0, sw = img.naturalWidth, sh = img.naturalHeight;
        if (imgAspect > boxAspect) {
          sw = img.naturalHeight * boxAspect;
          sx = (img.naturalWidth - sw) * 0.82;
        } else {
          sh = img.naturalWidth / boxAspect;
          sy = (img.naturalHeight - sh) * 0.2;
        }
        octx.drawImage(img, sx, sy, sw, sh, 0, 0, cols, rows);

        const { data } = octx.getImageData(0, 0, cols, rows);
        grid = new Array(cols * rows);
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const idx = (y * cols + x) * 4;
            const lum = (0.299 * data[idx] + 0.587 * data[idx + 1] + 0.114 * data[idx + 2]) / 255;
            const boosted = Math.min(1, Math.max(0, (lum - 0.06) * 1.32));
            grid[y * cols + x] = {
              lum: boosted,
              char: GLYPHS[Math.floor(Math.random() * GLYPHS.length)],
            };
          }
        }
        drops = Array.from({ length: cols }, () => Math.floor(Math.random() * rows));
        drawMatrix(rect.width, rect.height);
      }

      function drawMatrix(width, height) {
        ctx.clearRect(0, 0, width, height);
        ctx.font = `700 ${cell - 1}px ui-monospace, SFMono-Regular, Menlo, monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';

        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const item = grid[y * cols + x];
            if (!item) continue;
            const px = x * cell;
            const py = y * cell;

            // Rain trail boost per column
            const dist = (drops[x] - y + rows) % rows;
            const isHead = dist === 0;
            const trail = dist < 5 ? (1 - dist / 5) * 0.5 : 0;

            // Subtle dark-green pixel grid overlay keeping the portrait clearly visible
            if (item.lum < 0.2) {
              ctx.fillStyle = 'rgba(2, 10, 5, 0.54)';
            } else {
              ctx.fillStyle = `rgba(10, 130, 62, ${0.1 + item.lum * 0.18})`;
            }
            ctx.fillRect(px + 0.5, py + 0.5, cell - 1, cell - 1);

            // Matrix glyph foreground on rain trails and bright pixels
            if (isHead) {
              ctx.fillStyle = 'rgba(187, 247, 208, 0.9)';
              ctx.fillText(item.char, px + cell / 2, py + cell / 2 + 0.5);
            } else if (trail > 0.08 || item.lum > 0.38) {
              const g = Math.round(135 + Math.max(item.lum, trail) * 95);
              const a = Math.min(0.78, 0.2 + trail * 0.58 + item.lum * 0.22);
              ctx.fillStyle = `rgba(20, ${g}, 72, ${a})`;
              ctx.fillText(item.char, px + cell / 2, py + cell / 2 + 0.5);
            }
          }
        }
      }

      function tick(ts) {
        if (ts - lastTick > 48 && grid.length) {
          lastTick = ts;
          const rect = canvas.getBoundingClientRect();
          for (let x = 0; x < cols; x++) {
            if (Math.random() > 0.12) {
              drops[x] = (drops[x] + 1) % rows;
            }
            const y = drops[x];
            const k = y * cols + x;
            if (grid[k]) {
              grid[k].char = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
            }
          }
          for (let i = 0; i < Math.max(12, Math.floor(grid.length * 0.025)); i++) {
            const k = Math.floor(Math.random() * grid.length);
            if (grid[k]) {
              grid[k].char = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
            }
          }
          drawMatrix(rect.width, rect.height);
        }
        rafId = requestAnimationFrame(tick);
      }

      function init() {
        samplePortrait();
        if (!reduceMotion && !rafId) {
          rafId = requestAnimationFrame(tick);
        }
      }

      if (img.complete) {
        init();
      } else {
        img.addEventListener('load', init, { once: true });
      }
      window.addEventListener('resize', samplePortrait, { passive: true });

      const marioBtn = document.getElementById('mario-1up-btn');
      if (marioBtn) {
        let count = 0;
        marioBtn.addEventListener('click', () => {
          count += 1;
          const badge = document.createElement('span');
          badge.className = 'mario-1up';
          badge.textContent = count % 5 === 0 ? '★ STAR!' : '1-UP!';
          marioBtn.appendChild(badge);
          setTimeout(() => badge.remove(), 750);
        });
      }
    })();
  </script>
</BaseLayout>
