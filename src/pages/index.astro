---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestPosts = posts.slice(0, 6);

const projects = [
  {
    name: 'yggdrasil-ts',
    desc: 'Node.js server boilerplate in TypeScript with JWT authentication, TypeGraphQL, and TypeORM.',
    stack: 'TypeScript',
    url: 'https://github.com/mabuonomo/yggdrasil-ts',
  },
  {
    name: 'nestjs-guard-grpc',
    desc: 'Agnostic authentication guard tailored for gRPC scopes and microservices in NestJS.',
    stack: 'gRPC',
    url: 'https://github.com/mabuonomo/nestjs-guard-grpc',
  },
  {
    name: 'yggdrasil-springboot',
    desc: 'Spring Boot server boilerplate in Java with JWT authentication, GraphQL, and Hibernate.',
    stack: 'Java',
    url: 'https://github.com/mabuonomo/yggdrasil-springboot',
  },
  {
    name: 'abbashare',
    desc: 'Install iOS .ipa builds directly through Safari on iOS without TestFlight or iTunes.',
    stack: 'iOS OTA',
    url: 'https://github.com/mabuonomo/abbashare_web',
  },
];

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://mabuonomo.github.io/#person',
      name: 'Mario Buonomo',
      url: 'https://mabuonomo.github.io/',
      image: 'https://mabuonomo.github.io/assets/images/profile-manga.jpg',
      jobTitle: 'Staff Engineer',
      worksFor: {
        '@type': 'Organization',
        name: 'Facile.it',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Milan',
        addressCountry: 'IT',
      },
      knowsAbout: [
        'People Management',
        'Engineering Leadership',
        'TypeScript',
        'Node.js',
        'Kubernetes',
        'BLE 5.0',
        'ESP32',
        'Smart Home',
        'Home Assistant',
        'Applied AI',
        'Python',
        'Telegram Bots',
        'Android Kotlin',
        'Godot',
        'Three.js',
      ],
      sameAs: [
        'https://github.com/mabuonomo',
        'https://www.linkedin.com/in/mariobuonomo/',
        'https://www.twitter.com/mariobuonomo/',
        'https://instagram.com/mariobuonomo',
        'https://www.reddit.com/user/mabuonomo/',
        'https://www.youtube.com/@devilfruitai',
        'https://t.me/devilfruitai',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://mabuonomo.github.io/#website',
      url: 'https://mabuonomo.github.io/',
      name: 'Mario Buonomo — Staff Engineer',
      publisher: { '@id': 'https://mabuonomo.github.io/#person' },
    },
  ],
};
---

<BaseLayout
  title="Mario Buonomo: Staff Engineer in Milan"
  description="Staff Engineer at Facile.it, based in Milan. People management & engineering leadership, distributed backends in TypeScript and Node.js, Kubernetes & GitOps, BLE 5.0/ESP32 IoT, applied AI, Godot/Three.js, and manga lore (@devilfruitai)."
  currentPath="/"
  jsonLd={homeJsonLd}
>
  <section class="hero hero--split bg-topglow" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text grid hero__grid">
        <div class="hero__text span-6">
          <p class="hero__kicker">
            <span class="dot" aria-hidden="true"></span>
            Milan, Italy · Staff Engineer @ Facile.it
            <button type="button" class="mario-pixel-btn" id="mario-1up-btn" title="Press for 1-UP" aria-label="Super Mario 1-UP">
              <svg width="24" height="24" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
                <rect x="2" y="1" width="12" height="14" fill="#d97706"/>
                <rect x="1" y="2" width="14" height="12" fill="#f59e0b"/>
                <rect x="2" y="2" width="12" height="12" fill="#fbbf24"/>
                <rect x="3" y="3" width="1" height="1" fill="#78350f"/>
                <rect x="12" y="3" width="1" height="1" fill="#78350f"/>
                <rect x="3" y="12" width="1" height="1" fill="#78350f"/>
                <rect x="12" y="12" width="1" height="1" fill="#78350f"/>
                <rect x="5" y="4" width="6" height="2" fill="#fffbeb"/>
                <rect x="9" y="6" width="2" height="2" fill="#fffbeb"/>
                <rect x="7" y="7" width="2" height="2" fill="#fffbeb"/>
                <rect x="7" y="10" width="2" height="2" fill="#fffbeb"/>
              </svg>
            </button>
          </p>
          <h1 id="hero-h">Ciao! I'm Mario — architecting backend, IoT &amp; AI systems</h1>
          <p class="hero__lead">Computer engineer from Naples, based in Milan. Staff Engineer at Facile.it, combining people management and technical mentorship with distributed backends in TypeScript and Node.js, Kubernetes infrastructure, BLE/ESP32 telemetry, and applied AI — and a lifelong manga fan sharing theories and AI-powered lore with @devilfruitai.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/#contact"><svg class="mario-star-icon" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true"><rect x="7" y="1" width="2" height="2" fill="#0b0c0e"/><rect x="6" y="3" width="4" height="2" fill="#0b0c0e"/><rect x="1" y="5" width="14" height="2" fill="#0b0c0e"/><rect x="2" y="7" width="12" height="2" fill="#0b0c0e"/><rect x="3" y="9" width="10" height="2" fill="#0b0c0e"/><rect x="2" y="11" width="5" height="2" fill="#0b0c0e"/><rect x="9" y="11" width="5" height="2" fill="#0b0c0e"/><rect x="1" y="13" width="4" height="2" fill="#0b0c0e"/><rect x="11" y="13" width="4" height="2" fill="#0b0c0e"/><rect x="7" y="2" width="2" height="2" fill="#fde047"/><rect x="6" y="4" width="4" height="2" fill="#fde047"/><rect x="2" y="6" width="12" height="2" fill="#fde047"/><rect x="4" y="8" width="8" height="2" fill="#facc15"/><rect x="3" y="10" width="4" height="2" fill="#facc15"/><rect x="9" y="10" width="4" height="2" fill="#facc15"/><rect x="2" y="12" width="3" height="2" fill="#eab308"/><rect x="11" y="12" width="3" height="2" fill="#eab308"/><rect x="6" y="6" width="1" height="2" fill="#111827"/><rect x="9" y="6" width="1" height="2" fill="#111827"/></svg>Contact Mario<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
            <a class="btn btn--secondary" href="/blog/">Read articles</a>
          </div>
          <div class="hero-socials" aria-label="Social profiles">
            <a class="hero-social hero-social--github" href="https://github.com/mabuonomo" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
              GitHub
            </a>
            <a class="hero-social hero-social--linkedin" href="https://www.linkedin.com/in/mariobuonomo/" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z"/></svg>
              LinkedIn
            </a>
            <a class="hero-social hero-social--twitter" href="https://www.twitter.com/mariobuonomo/" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.46 6c-.77.35-1.6.58-2.46.69.88-.53 1.56-1.37 1.88-2.38-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29 0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15 0 1.49.75 2.81 1.91 3.56-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.22 4.22 0 0 1-1.93.07 4.28 4.28 0 0 0 4 2.98 8.521 8.521 0 0 1-5.33 1.84c-.34 0-.68-.02-1.02-.06C3.44 20.29 5.7 21 8.12 21 16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56.84-.6 1.56-1.36 2.14-2.23Z"/></svg>
              Twitter
            </a>
            <a class="hero-social hero-social--instagram" href="https://instagram.com/mariobuonomo" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3Z"/></svg>
              Instagram
            </a>
            <a class="hero-social hero-social--facebook" href="https://www.facebook.com/mariobuonomo" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02Z"/></svg>
              Facebook
            </a>
            <a class="hero-social hero-social--reddit" href="https://www.reddit.com/user/mabuonomo/" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.5 15.41c.08.08.08.22 0 .3-.65.65-1.89.7-2.5.7s-1.85-.05-2.5-.7a.21.21 0 0 1 0-.3.21.21 0 0 1 .3 0c.39.39 1.22.53 2.2.53s1.81-.14 2.2-.53a.21.21 0 0 1 .3 0ZM9.74 13c0-.55.45-1 1-1s1 .45 1 1-.45 1-1 1-1-.45-1-1Zm4.52 0c0-.55-.45-1-1-1s-1 .45-1 1 .45 1 1 1 1-.45 1-1ZM22 12c0 5.52-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2s10 4.48 10 10Zm-3.87-1.14c-.55 0-1.05.24-1.41.61-1.36-.92-3.17-1.51-5.16-1.58l.9-4.18 2.9.62c0 .69.56 1.25 1.25 1.25s1.25-.56 1.25-1.25S17.3 5.08 16.61 5.08c-.49 0-.91.29-1.11.7l-3.26-.7a.28.28 0 0 0-.33.21l-1 4.65c-2.04.05-3.88.64-5.26 1.57a1.99 1.99 0 0 0-1.4-.61c-1.1 0-2 .9-2 2 0 .81.48 1.5 1.18 1.82-.03.22-.05.45-.05.68 0 3.04 3.55 5.5 7.93 5.5s7.93-2.46 7.93-5.5c0-.23-.02-.46-.05-.68.7-.32 1.18-1.01 1.18-1.82 0-1.1-.9-2-2-2Z"/></svg>
              Reddit
            </a>
          </div>
        </div>
        <div class="hero__profile-wrap span-6 start-7">
          <div class="hero-profile">
            <div class="hero-profile__top">
              <span class="sys-card__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>mario@facile.it ~ staff</span>
              <span class="sys-card__live">ACTIVE</span>
            </div>
            <div class="hero-profile__body">
              <div class="hero-profile__img">
                <img
                  id="hero-portrait-src"
                  src="/assets/images/profile-manga.jpg"
                  alt="Mario Buonomo manga-style portrait"
                  width="1280"
                  height="720"
                  fetchpriority="high"
                  loading="eager"
                >
                <canvas id="matrix-portrait" class="hero-profile__canvas" aria-hidden="true"></canvas>
              </div>
              <div class="hero-profile__meta">
                <div class="hero-profile__tags">
                  <span class="hero-profile__tag">TypeScript</span>
                  <span class="hero-profile__tag">Node.js</span>
                  <span class="hero-profile__tag">Kubernetes</span>
                  <span class="hero-profile__tag">ESP32 / Arduino</span>
                  <span class="hero-profile__tag">MicroPython</span>
                  <span class="hero-profile__tag">Home Assistant</span>
                  <span class="hero-profile__tag">Telegram Bots</span>
                  <span class="hero-profile__tag">Godot</span>
                  <span class="hero-profile__tag">Three.js</span>
                  <span class="hero-profile__tag">AI Agents</span>
                  <span class="hero-profile__tag">People Management</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="expertise" aria-labelledby="expertise-h">
    <div class="wrap grid">
      <div class="span-6">
        <div class="section-head">
          <h2 id="expertise-h">Core engineering stack. <span class="muted">Backend, cloud infra, IoT, and AI.</span></h2>
        </div>
        <ul class="rows">
          <li>
            <span class="rows__name">People Management &amp; Leadership<small>Team mentoring, 1:1s, technical hiring, career growth &amp; cross-team alignment</small></span>
            <span class="rows__value">Leadership</span>
          </li>
          <li>
            <span class="rows__name">TypeScript &amp; Node.js<small>Distributed backends, NestJS, gRPC &amp; GraphQL APIs</small></span>
            <span class="rows__value">Backend</span>
          </li>
          <li>
            <span class="rows__name">Kubernetes, K3s &amp; GitOps<small>Docker, Traefik, RabbitMQ, InfluxDB, Grafana &amp; CI/CD pipelines</small></span>
            <span class="rows__value">Infra</span>
          </li>
          <li>
            <span class="rows__name">BLE 5.0, ESP32 &amp; Smart Home<small>Arduino, MicroPython, Home Assistant, ESP-NOW &amp; MQTTS telemetry</small></span>
            <span class="rows__value">Embedded</span>
          </li>
          <li>
            <span class="rows__name">Applied AI &amp; LLM Agents<small>LangChain, LangGraph, Ollama, MLflow &amp; tool-calling workflows</small></span>
            <span class="rows__value">AI / LLM</span>
          </li>
          <li>
            <span class="rows__name">Python, Telegram Bots &amp; Android<small>Async community bots, AI quizzes &amp; Pillow cards, Jetpack Compose &amp; BLE</small></span>
            <span class="rows__value">Apps &amp; Bots</span>
          </li>
          <li>
            <span class="rows__name">Videogames &amp; 3D Graphics<small>Godot Engine, Three.js scenes, WebGL shaders &amp; automated 3D rendering</small></span>
            <span class="rows__value">Games &amp; 3D</span>
          </li>
        </ul>
      </div>
      <div class="span-6 start-7">
        <div class="stack-card" aria-label="Staff Engineering Core domains">
          <div class="stack-card__bar">
            <span class="sys-card__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>staff-eng / domains</span>
            <span class="sys-card__live">ACTIVE</span>
          </div>
          <div class="stack-card__grid">
            <div class="stack-tile">
              <span class="stack-tile__icon stack-tile__icon--lead" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </span>
              <div>
                <div class="stack-tile__title">People &amp; Leadership</div>
                <div class="stack-tile__sub">Mentoring, 1:1s &amp; hiring</div>
              </div>
            </div>
            <div class="stack-tile">
              <span class="stack-tile__icon stack-tile__icon--back" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              </span>
              <div>
                <div class="stack-tile__title">TypeScript &amp; Node.js</div>
                <div class="stack-tile__sub">NestJS, gRPC &amp; GraphQL</div>
              </div>
            </div>
            <div class="stack-tile">
              <span class="stack-tile__icon stack-tile__icon--infra" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
              </span>
              <div>
                <div class="stack-tile__title">Kubernetes &amp; GitOps</div>
                <div class="stack-tile__sub">K3s, Docker &amp; Grafana</div>
              </div>
            </div>
            <div class="stack-tile">
              <span class="stack-tile__icon stack-tile__icon--iot" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
              </span>
              <div>
                <div class="stack-tile__title">BLE 5.0 &amp; ESP32</div>
                <div class="stack-tile__sub">Arduino, HA &amp; MicroPython</div>
              </div>
            </div>
            <div class="stack-tile">
              <span class="stack-tile__icon stack-tile__icon--ai" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 1 4 4v2h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2V6a4 4 0 0 1 4-4Z"/><path d="M9 14h.01M15 14h.01"/></svg>
              </span>
              <div>
                <div class="stack-tile__title">AI &amp; Telegram Bots</div>
                <div class="stack-tile__sub">LangGraph, Ollama &amp; Python</div>
              </div>
            </div>
            <div class="stack-tile">
              <span class="stack-tile__icon stack-tile__icon--games" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><rect x="2" y="6" width="20" height="12" rx="4"/></svg>
              </span>
              <div>
                <div class="stack-tile__title">Godot &amp; Three.js</div>
                <div class="stack-tile__sub">2D/3D Games &amp; WebGL</div>
              </div>
            </div>
          </div>
          <div class="sys-card__foot">
            <span>Staff Eng.</span>
            <span>Kotlin</span>
            <span>RabbitMQ</span>
            <span>InfluxDB</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section ground-inverse" id="projects" aria-labelledby="projects-h">
    <div class="wrap grid">
      <div class="span-6">
        <div class="section-head">
          <h2 id="projects-h">Open-source projects. <span class="muted">Boilerplates, middleware, and developer tools on GitHub.</span></h2>
        </div>
        <ul class="rows rows--inv">
          {projects.map((project) => (
            <li>
              <span class="rows__name">
                <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
                <small>{project.desc}</small>
              </span>
              <span class="rows__value">{project.stack}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="span-6 start-7">
        <div class="sys-card" aria-label="Distributed systems and telemetry architecture preview">
          <div class="sys-card__bar">
            <span class="sys-card__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>cluster / telemetry-pipeline</span>
            <span class="sys-card__live">ONLINE</span>
          </div>
          <div class="sys-card__body">
            <div class="sys-node">
