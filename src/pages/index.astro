---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const latestPosts = posts.slice(0, 6);

const projects = [
  {
    name: 'yggdrasil-ts',
    desc: 'Node.js server boilerplate in TypeScript with JWT authentication, TypeGraphQL, and TypeORM.',
    stack: 'TypeScript',
    url: 'https://github.com/mabuonomo/yggdrasil-ts',
  },
  {
    name: 'nestjs-guard-grpc',
    desc: 'Agnostic authentication guard tailored for gRPC scopes and microservices in NestJS.',
    stack: 'gRPC',
    url: 'https://github.com/mabuonomo/nestjs-guard-grpc',
  },
  {
    name: 'yggdrasil-springboot',
    desc: 'Spring Boot server boilerplate in Java with JWT authentication, GraphQL, and Hibernate.',
    stack: 'Java',
    url: 'https://github.com/mabuonomo/yggdrasil-springboot',
  },
  {
    name: 'abbashare',
    desc: 'Install iOS .ipa builds directly through Safari on iOS without TestFlight or iTunes.',
    stack: 'iOS OTA',
    url: 'https://github.com/mabuonomo/abbashare_web',
  },
];

const stackDiagram = JSON.stringify({
  layout: 'hub',
  alt: 'Staff Engineering Core connects TypeScript, Node.js, Kubernetes, GitOps CI, BLE & ESP32 IoT, and AI Workflows.',
  center: { label: 'Staff Eng.', icon: 'ui:code' },
  spokes: [
    { label: 'Node & GraphQL', icon: 'graphql' },
    { label: 'TypeScript', icon: 'ts' },
    { label: 'Kubernetes', icon: 'kubernetes' },
    { label: 'GitOps & CI', icon: 'github' },
    { label: 'BLE & ESP32', icon: 'docker' },
    { label: 'AI & Python', icon: 'js' },
  ],
});
---

<BaseLayout
  title="Mario Buonomo: Staff Engineer in Milan"
  description="Staff Engineer at Facile.it, based in Milan. Architecting backend systems in TypeScript, Node.js, and PHP, Kubernetes & GitOps infrastructure, BLE/ESP32 IoT telemetry, and applied AI workflows."
  currentPath="/"
>
  <section class="hero hero--split bg-topglow" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text grid hero__grid">
        <div class="hero__text span-6">
          <p class="hero__kicker">
            <span class="dot" aria-hidden="true"></span>
            Milan, Italy · Staff Engineer @ Facile.it
            <button type="button" class="mario-pixel-btn" id="mario-1up-btn" title="Press for 1-UP" aria-label="Super Mario 1-UP">
              <svg width="24" height="24" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true">
                <rect x="2" y="1" width="12" height="14" fill="#d97706"/>
                <rect x="1" y="2" width="14" height="12" fill="#f59e0b"/>
                <rect x="2" y="2" width="12" height="12" fill="#fbbf24"/>
                <rect x="3" y="3" width="1" height="1" fill="#78350f"/>
                <rect x="12" y="3" width="1" height="1" fill="#78350f"/>
                <rect x="3" y="12" width="1" height="1" fill="#78350f"/>
                <rect x="12" y="12" width="1" height="1" fill="#78350f"/>
                <rect x="5" y="4" width="6" height="2" fill="#fffbeb"/>
                <rect x="9" y="6" width="2" height="2" fill="#fffbeb"/>
                <rect x="7" y="7" width="2" height="2" fill="#fffbeb"/>
                <rect x="7" y="10" width="2" height="2" fill="#fffbeb"/>
              </svg>
            </button>
          </p>
          <h1 id="hero-h">Ciao! I'm Mario — architecting backend, IoT &amp; AI systems</h1>
          <p class="hero__lead">Computer engineer from Naples, based in Milan. Staff Engineer at Facile.it, working across distributed backends in TypeScript, Node.js, and PHP, Kubernetes infrastructure, BLE/ESP32 telemetry, and applied AI.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/#contact"><svg class="mario-star-icon" viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true"><rect x="7" y="1" width="2" height="2" fill="#0b0c0e"/><rect x="6" y="3" width="4" height="2" fill="#0b0c0e"/><rect x="1" y="5" width="14" height="2" fill="#0b0c0e"/><rect x="2" y="7" width="12" height="2" fill="#0b0c0e"/><rect x="3" y="9" width="10" height="2" fill="#0b0c0e"/><rect x="2" y="11" width="5" height="2" fill="#0b0c0e"/><rect x="9" y="11" width="5" height="2" fill="#0b0c0e"/><rect x="1" y="13" width="4" height="2" fill="#0b0c0e"/><rect x="11" y="13" width="4" height="2" fill="#0b0c0e"/><rect x="7" y="2" width="2" height="2" fill="#fde047"/><rect x="6" y="4" width="4" height="2" fill="#fde047"/><rect x="2" y="6" width="12" height="2" fill="#fde047"/><rect x="4" y="8" width="8" height="2" fill="#facc15"/><rect x="3" y="10" width="4" height="2" fill="#facc15"/><rect x="9" y="10" width="4" height="2" fill="#facc15"/><rect x="2" y="12" width="3" height="2" fill="#eab308"/><rect x="11" y="12" width="3" height="2" fill="#eab308"/><rect x="6" y="6" width="1" height="2" fill="#111827"/><rect x="9" y="6" width="1" height="2" fill="#111827"/></svg>Contact Mario<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
            <a class="btn btn--secondary" href="/blog/">Read articles</a>
          </div>
          <div class="hero-socials" aria-label="Social profiles">
            <a class="hero-social hero-social--github" href="https://github.com/mabuonomo" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
              GitHub
