  <script>
    (() => {
      const canvas = document.getElementById('matrix-portrait');
      if (canvas instanceof HTMLCanvasElement) {
        const ctx = canvas.getContext('2d');
        if (ctx) {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          let width = 0;
          let height = 0;
          let phase = 0;
          let rafId = 0;
          let isHovered = false;

          const container = canvas.parentElement;
          if (container) {
            container.addEventListener('mouseenter', () => { isHovered = true; }, { passive: true });
            container.addEventListener('mouseleave', () => { isHovered = false; }, { passive: true });
          }

          const sparks = Array.from({ length: 26 }, (_, i) => ({
            x: Math.random() * 0.62,
            y: Math.random(),
            vy: 0.0018 + Math.random() * 0.0032,
            vx: (Math.random() - 0.5) * 0.0009,
            size: 1.5 + Math.random() * 2.6,
            hue: i % 3 === 0 ? '56, 189, 248' : i % 5 === 0 ? '250, 204, 21' : '74, 222, 128',
            phase: Math.random() * Math.PI * 2,
          }));

          const sfx = [
            { char: 'ゴ', rx: 0.1, ry: 0.2, size: 20, rot: -0.22, phase: 0.0, color: '#4ade80' },
            { char: 'ゴ', rx: 0.16, ry: 0.31, size: 15, rot: -0.14, phase: 1.3, color: '#38bdf8' },
            { char: 'ド', rx: 0.11, ry: 0.82, size: 19, rot: 0.12, phase: 2.6, color: '#facc15' },
          ];

          const floaters = [
            { kind: 'devilfruit', rx: 0.29, ry: 0.25, size: 15, rot: -0.15, phase: 0.4, color: '#a855f7', accent: '#e9d5ff' },
            { kind: 'devilfruit', rx: 0.41, ry: 0.76, size: 12, rot: 0.18, phase: 2.1, color: '#f97316', accent: '#fed7aa' },
            { kind: 'code', label: '</>', rx: 0.38, ry: 0.18, size: 12, rot: 0.08, phase: 1.1, color: '#38bdf8' },
            { kind: 'chip', rx: 0.22, ry: 0.57, size: 13, rot: -0.1, phase: 3.0, color: '#4ade80' },
            { kind: 'starball', rx: 0.46, ry: 0.44, size: 11, rot: 0.1, phase: 1.8, color: '#facc15' },
            { kind: 'shuriken', rx: 0.27, ry: 0.84, size: 11, rot: 0, phase: 0.9, color: '#e2e8f0' },
          ];

          const streaks = Array.from({ length: 14 }, (_, i) => ({
            angle: Math.PI * (0.72 + (i / 14) * 0.64),
            inner: 0.45 + Math.random() * 0.2,
            len: 0.18 + Math.random() * 0.22,
            width: 0.8 + Math.random() * 1.4,
            phase: Math.random() * Math.PI * 2,
          }));

          function drawDevilFruit(r, color, accent) {
            // Stem with curl
            ctx.strokeStyle = '#4ade80';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, -r * 0.85);
            ctx.quadraticCurveTo(r * 0.25, -r * 1.45, r * 0.55, -r * 1.25);
            ctx.stroke();

            // Fruit body
            ctx.fillStyle = color;
            ctx.strokeStyle = 'rgba(4, 9, 6, 0.9)';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.arc(0, 0, r, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            // Iconic Devil Fruit spiral swirl
            ctx.strokeStyle = accent;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            for (let t = 0; t < Math.PI * 3.1; t += 0.25) {
              const sr = (t / (Math.PI * 3.1)) * r * 0.66;
              const sx = Math.cos(t) * sr;
              const sy = Math.sin(t) * sr;
              if (t === 0) ctx.moveTo(sx, sy);
              else ctx.lineTo(sx, sy);
            }
            ctx.stroke();
          }

          function drawTechChip(r, color) {
            const s = r * 1.25;
            ctx.strokeStyle = color;
            ctx.fillStyle = 'rgba(11, 12, 14, 0.85)';
            ctx.lineWidth = 1.6;
            // Pins
            for (const o of [-s * 0.32, s * 0.32]) {
              ctx.beginPath();
              ctx.moveTo(o, -s * 0.55); ctx.lineTo(o, -s * 0.88);
              ctx.moveTo(o, s * 0.55); ctx.lineTo(o, s * 0.88);
              ctx.moveTo(-s * 0.55, o); ctx.lineTo(-s * 0.88, o);
              ctx.moveTo(s * 0.55, o); ctx.lineTo(s * 0.88, o);
              ctx.stroke();
            }
            ctx.beginPath();
            ctx.roundRect(-s * 0.55, -s * 0.55, s * 1.1, s * 1.1, 3);
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(0, 0, s * 0.16, 0, Math.PI * 2);
            ctx.fill();
          }

          function drawStarBall(r, color) {
            ctx.fillStyle = color;
            ctx.strokeStyle = 'rgba(4, 9, 6, 0.9)';
            ctx.lineWidth = 1.8;
            ctx.beginPath();
            ctx.arc(0, 0, r, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();
            // 4 tiny red stars
            ctx.fillStyle = '#dc2626';
            for (const [sx, sy] of [[-0.3, -0.25], [0.3, -0.25], [-0.25, 0.3], [0.25, 0.3]]) {
              ctx.beginPath();
              ctx.arc(sx * r, sy * r, r * 0.16, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          function drawShuriken(r, color) {
            ctx.fillStyle = color;
            ctx.strokeStyle = 'rgba(4, 9, 6, 0.9)';
            ctx.lineWidth = 1.4;
            ctx.beginPath();
            for (let i = 0; i < 4; i++) {
              const a = (i * Math.PI) / 2;
              ctx.lineTo(Math.cos(a) * r, Math.sin(a) * r);
              ctx.lineTo(Math.cos(a + 0.45) * r * 0.35, Math.sin(a + 0.45) * r * 0.35);
            }
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            ctx.fillStyle = '#0b0c0e';
            ctx.beginPath();
            ctx.arc(0, 0, r * 0.18, 0, Math.PI * 2);
            ctx.fill();
          }

          function resize() {
            const rect = canvas.getBoundingClientRect();
            if (!rect.width || !rect.height) return;
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = rect.width;
            height = rect.height;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            draw();
          }

          function draw() {
            if (!width || !height) return;
            ctx.clearRect(0, 0, width, height);
            const boost = isHovered ? 1.5 : 1;

            // 1. Subtle anime speedlines on the left/outer edges (keeps face untouched)
            const fx = width * 0.74;
            const fy = height * 0.42;
            const maxR = Math.hypot(width, height);
            for (const st of streaks) {
              const pulse = 0.5 + 0.5 * Math.sin(phase * 2.2 + st.phase);
              const r0 = maxR * (st.inner + Math.sin(phase * 1.5 + st.phase) * 0.04);
              const r1 = r0 + maxR * st.len;
              ctx.strokeStyle = `rgba(74, 222, 128, ${(0.08 + pulse * 0.14) * boost})`;
              ctx.lineWidth = st.width;
              ctx.beginPath();
              ctx.moveTo(fx + Math.cos(st.angle) * r0, fy + Math.sin(st.angle) * r0);
              ctx.lineTo(fx + Math.cos(st.angle) * r1, fy + Math.sin(st.angle) * r1);
              ctx.stroke();
            }

            // 2. Rising shonen energy sparks
            for (const sp of sparks) {
              const px = (sp.x + Math.sin(phase * 1.4 + sp.phase) * 0.015) * width;
              const py = sp.y * height;
              const alpha = (0.35 + 0.45 * Math.sin(phase * 2.8 + sp.phase)) * Math.min(1.2, boost);
              ctx.fillStyle = `rgba(${sp.hue}, ${Math.max(0.12, alpha)})`;
              ctx.beginPath();
              ctx.ellipse(px, py, sp.size * 0.75, sp.size * 1.6, 0.15, 0, Math.PI * 2);
              ctx.fill();
            }

            // 3. Floating Devil Fruits, Tech & Manga icons
            for (const fl of floaters) {
              const bobY = Math.sin(phase * 1.6 + fl.phase) * (isHovered ? 7 : 4.5);
              const bobX = Math.cos(phase * 1.1 + fl.phase) * (isHovered ? 4 : 2);
              ctx.save();
              ctx.translate(width * fl.rx + bobX, height * fl.ry + bobY);
              if (fl.kind === 'shuriken') {
                ctx.rotate(phase * (isHovered ? 2.2 : 1.1) + fl.phase);
              } else {
                ctx.rotate(fl.rot + Math.sin(phase + fl.phase) * 0.08);
              }
              ctx.globalAlpha = 0.9;
              if (fl.kind === 'devilfruit') {
                drawDevilFruit(fl.size, fl.color, fl.accent);
              } else if (fl.kind === 'chip') {
                drawTechChip(fl.size, fl.color);
              } else if (fl.kind === 'starball') {
                drawStarBall(fl.size, fl.color);
              } else if (fl.kind === 'shuriken') {
                drawShuriken(fl.size, fl.color);
              } else if (fl.kind === 'code') {
                ctx.font = `800 ${fl.size}px ui-monospace, SFMono-Regular, Menlo, monospace`;
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillStyle = 'rgba(11, 12, 14, 0.85)';
                ctx.strokeStyle = fl.color;
                ctx.lineWidth = 1.4;
                ctx.beginPath();
                ctx.roundRect(-18, -11, 36, 22, 6);
                ctx.fill();
                ctx.stroke();
                ctx.fillStyle = fl.color;
                ctx.fillText(fl.label, 0, 0.5);
              }
              ctx.restore();
            }

            // 4. Playful floating manga SFX ("ゴゴゴ", "ド") on the left dark space
            for (const item of sfx) {
              const bobY = Math.sin(phase * 1.9 + item.phase) * (isHovered ? 5 : 3);
              const bobX = Math.cos(phase * 1.4 + item.phase) * (isHovered ? 3 : 1.5);
              ctx.save();
              ctx.translate(width * item.rx + bobX, height * item.ry + bobY);
              ctx.rotate(item.rot + Math.sin(phase * 1.2 + item.phase) * 0.05);
              ctx.font = `900 ${item.size}px "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif`;
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.lineWidth = 3.5;
              ctx.strokeStyle = 'rgba(4, 9, 6, 0.9)';
              ctx.strokeText(item.char, 0, 0);
              ctx.fillStyle = item.color;
              ctx.globalAlpha = 0.82 + 0.15 * Math.sin(phase * 2 + item.phase);
              ctx.fillText(item.char, 0, 0);
              ctx.restore();
            }
          }

          function tick() {
            phase += isHovered ? 0.055 : 0.032;
            const speedMult = isHovered ? 1.85 : 1;
            for (const sp of sparks) {
              sp.y -= sp.vy * speedMult;
              sp.x += sp.vx * speedMult;
              if (sp.y < -0.05) {
                sp.y = 1.05;
                sp.x = Math.random() * 0.62;
              }
            }
            draw();
            rafId = requestAnimationFrame(tick);
          }

          resize();
          if (!reduceMotion && !rafId) {
            rafId = requestAnimationFrame(tick);
          }
          window.addEventListener('resize', resize, { passive: true });
        }
      }

      const marioBtn = document.getElementById('mario-1up-btn');
      if (marioBtn) {
        let count = 0;
        marioBtn.addEventListener('click', () => {
          count += 1;
          const badge = document.createElement('span');
          badge.className = 'mario-1up';
          badge.textContent = count % 5 === 0 ? '★ STAR!' : '1-UP!';
          marioBtn.appendChild(badge);
          setTimeout(() => badge.remove(), 750);
        });
      }
    })();
  </script>
