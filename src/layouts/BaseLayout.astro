---
interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '/' } = Astro.props;
const isBlog = currentPath.startsWith('/blog');
---
<!doctype html>
<html lang="en" data-type="service" data-radius="soft" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#0b0c0e">
<link rel="canonical" href={`https://mabuonomo.github.io${currentPath}`}>
<meta name="site-kind" content="other">
<meta name="page-type" content="service">
{import.meta.env.PROD && (
  <>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5LN1MZYY8Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5LN1MZYY8Y');
    </script>
  </>
)}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400..700&family=Red+Hat+Text:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<link rel="stylesheet" href="/assets/diagrams/diagram.css">
<style is:global>
:root {
  color-scheme: dark;
  --p-bg: #0b0c0e; --p-surface: #17181a; --p-ink: #eef0f3; --p-muted: #9aa0aa;
  --p-accent: #3b57ff; --p-accent-ink: #ffffff; --p-action: #3b57ff; --p-action-ink: #ffffff;
  --p-inv-bg: #14161a; --p-inv-surface: #1c1f24; --p-inv-ink: #eef0f3; --p-inv-muted: #9aa0aa;
  --p-inv-accent: #eef0f3; --p-inv-accent-ink: #0b0c0e; --p-inv-action: #eef0f3; --p-inv-action-ink: #0b0c0e;
  --font-display: "Red Hat Display", system-ui, sans-serif;
  --font-text: "Red Hat Text", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.025em;
  --display-tracking-xl: -0.035em;
}

/* Cross-document view transitions (modern-web-guidance: cross-document-transitions) */
@media (prefers-reduced-motion: no-preference) {
  @view-transition {
    navigation: auto;
  }
}

@media (max-width: 1023px) {
  .nav--split .nav__bar {
    grid-template-columns: 1fr auto;
  }
  .nav--split .nav__logo {
    grid-column: 1;
    justify-self: start;
    font-size: 18px;
  }
}
@media (max-width: 639px) {
  .nav__actions {
    display: none;
  }
}

/* Hero portrait frame inside hero--split */
.hero__media img {
  border-radius: var(--r-lg);
}

/* Rows subtitle styling */
.rows .rows__name small {
  display: block;
  font-weight: 400;
  color: var(--muted);
  font-size: var(--t-small);
  margin-top: 2px;
}

/* Diagram & visual panels */
#expertise .panel {
  --p-h: 460px;
}
#projects .frame--photo,
#articles .frame--photo {
  height: min(480px, var(--ly-fit, 480px));
  border-radius: var(--r-lg);
  overflow: hidden;
}
#projects .frame--photo {
  background: #ffffff;
  padding: var(--s-4);
}
#projects .frame--photo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
#articles .frame--photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Project rows inside dark-band */
.rows--inv li {
  border-color: rgba(238, 240, 243, 0.14);
}
.rows--inv .rows__name a {
  color: var(--p-inv-ink);
  text-decoration: none;
}
.rows--inv .rows__name a:hover {
  text-decoration: underline;
}
.rows--inv .rows__name small {
  color: var(--p-inv-muted);
}
.rows--inv .rows__value {
  color: var(--p-inv-muted);
}

/* Compact, vertically centered statement section (avoids 100svh dead space) */
main > .section.statement {
  height: auto;
  min-height: 48svh;
  display: flex;
  align-items: center;
  padding-block: var(--s-10);
}
main > .section.statement > .wrap {
  height: auto;
}

/* Blog rows */
.articles-list {
  display: flex;
  flex-direction: column;
}
.article-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--s-5);
  padding-block: var(--s-4);
  border-bottom: 1px solid var(--hair);
  text-decoration: none;
  color: var(--ink);
}
.article-row:hover .article-row__title {
  color: #748ffc;
}
.article-row__title {
  font-size: var(--t-card);
  font-weight: 500;
  transition: color 0.15s ease;
}
.article-row__date {
  font-size: var(--t-small);
  color: var(--muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
@media (max-width: 639px) {
  .article-row {
    flex-direction: column;
    gap: var(--s-1);
  }
}

.footer__lede {
  margin: 0;
  font-size: var(--t-small);
  color: var(--muted);
}
.footer .nav__logo .mark--initial {
  width: 24px;
  height: 24px;
  font-size: 13px;
}

/* Tablet rhythm adjustment */
@media (min-width: 640px) and (max-width: 1023px) {
  #expertise { --h: 2; }
  #projects { --h: 2; }
  #articles { --h: 2; }
}
</style>
<script>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<link rel="modulepreload" href="/assets/moments/word-highlight/moment.js">
<slot name="head" />
</head>
<body>
<!-- type: service
     deal: hero split, nav nav-split, close close-type, footer footer-columns, rhythm dark-band, buttons arrow, mark initial
     moments: word-highlight -->
<header class="nav nav--split">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/#top"><span class="mark mark--initial" aria-hidden="true">M</span>Mario Buonomo</a>
    <nav class="nav__links" aria-label="Main">
      <div class="nav__item"><a class="nav__link" href="/#expertise">Stack</a></div>
      <div class="nav__item"><a class="nav__link" href="/#projects">Projects</a></div>
      <div class="nav__item"><a class="nav__link" href="/#articles">Articles</a></div>
      <div class="nav__item"><a class="nav__link" href="/blog/" aria-current={isBlog ? 'page' : undefined}>Blog</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="mailto:ma.buonomo@gmail.com">Contact Mario<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer closing" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--type">
      <div class="section-head">
        <h2 id="close-h">Start a conversation</h2>
        <p>Backend engineering, distributed systems, or technical writing inquiries.</p>
      </div>
      <a class="btn btn--primary" href="mailto:ma.buonomo@gmail.com">Contact Mario<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href="/#top"><span class="mark mark--initial" aria-hidden="true">M</span>Mario Buonomo</a>
          <p class="footer__lede">Computer engineer from Naples, based in Milan, Italy.</p>
        </div>
        <div class="span-2 footer__col">
          <h3>Explore</h3>
          <ul>
            <li><a href="/#expertise">Stack</a></li>
            <li><a href="/#projects">Projects</a></li>
            <li><a href="/#approach">Approach</a></li>
            <li><a href="/#articles">Articles</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Writing</h3>
          <ul>
            <li><a href="/blog/">All blog posts</a></li>
            <li><a href="/blog/tutorial-nestjs-microservices-grpc/">NestJS and gRPC</a></li>
            <li><a href="/blog/traefik-ssl-self-signed-development-mode/">Traefik SSL</a></li>
            <li><a href="/blog/docker-on-raspberry-pi/">Docker on Pi</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Code</h3>
          <ul>
            <li><a href="https://github.com/mabuonomo" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="https://stackoverflow.com/users/2621951/mario-buonomo" target="_blank" rel="noopener noreferrer">Stack Overflow</a></li>
          </ul>
        </div>
        <div class="span-2 footer__col">
          <h3>Connect</h3>
          <ul>
            <li><a href="https://www.linkedin.com/in/mariobuonomo/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href="https://twitter.com/mariobuonomo" target="_blank" rel="noopener noreferrer">Twitter</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__legal">
        <span>Mario Buonomo · 2026</span>
        <span>Milan, Italy</span>
      </div>
    </div>
  </div>
</footer>

<script type="module" src="/assets/system.js"></script>
<script type="module" src="/assets/motion/motion.js"></script>
<script type="module" src="/assets/layout/layout.js"></script>
<script type="module" src="/assets/diagrams/mount.js"></script>
</body>
</html>
