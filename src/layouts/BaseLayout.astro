---
interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '/' } = Astro.props;
const isBlog = currentPath.startsWith('/blog');
---
<!doctype html>
<html lang="en" data-type="software" data-mode="dark" data-radius="soft" data-buttons="arrow" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#0b0c0e">
<link rel="canonical" href={`https://mabuonomo.github.io${currentPath}`}>
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
{import.meta.env.PROD && (
  <>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5LN1MZYY8Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5LN1MZYY8Y');
    </script>
  </>
)}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@400..700&family=Red+Hat+Text:wght@400..600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<link rel="stylesheet" href="/assets/diagrams/diagram.css">
<style is:global>
:root {
  color-scheme: dark;
  --p-bg: #0b0c0e; --p-surface: #17181a; --p-ink: #eef0f3; --p-muted: #9aa0aa;
  --p-accent: #3b57ff; --p-accent-ink: #ffffff; --p-action: #3b57ff; --p-action-ink: #ffffff;
  --p-inv-bg: #14161a; --p-inv-surface: #1c1f24; --p-inv-ink: #eef0f3; --p-inv-muted: #9aa0aa;
  --p-inv-accent: #eef0f3; --p-inv-accent-ink: #0b0c0e; --p-inv-action: #eef0f3; --p-inv-action-ink: #0b0c0e;
  --font-display: "Red Hat Display", system-ui, sans-serif;
  --font-text: "Red Hat Text", system-ui, sans-serif;
  --display-weight: 400;
  --display-tracking: -0.025em;
  --display-tracking-xl: -0.035em;
}

/* Cross-document view transitions (modern-web-guidance: cross-document-transitions) */
@media (prefers-reduced-motion: no-preference) {
  html {
    scroll-behavior: smooth;
  }
  @view-transition {
    navigation: auto;
  }
}
section[id] {
  scroll-margin-top: 80px;
}

@media (max-width: 1023px) {
  .nav--split .nav__bar {
    grid-template-columns: 1fr auto;
  }
  .nav--split .nav__logo {
    grid-column: 1;
    justify-self: start;
    font-size: 18px;
  }
}
@media (max-width: 639px) {
  .nav__actions {
    display: none;
  }
}

/* Refined compact hero profile card */
.hero--split .hero__grid {
  align-items: start;
}
.hero--split .hero__text {
  align-self: start;
}
.hero__profile-wrap {
  display: flex;
  justify-content: stretch;
  width: 100%;
}
.hero-profile {
  width: 100%;
  background: rgba(14, 17, 20, 0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(74, 222, 128, 0.22);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: 0 28px 72px rgba(0, 0, 0, 0.6), 0 0 40px rgba(34, 197, 94, 0.08);
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}
.hero-profile:hover {
  transform: translateY(-2px);
  border-color: rgba(74, 222, 128, 0.48);
  box-shadow: 0 32px 80px rgba(0, 0, 0, 0.65), 0 0 48px rgba(34, 197, 94, 0.14);
}
.hero-profile__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  border-bottom: 1px solid rgba(238, 240, 243, 0.08);
  background: rgba(255, 255, 255, 0.02);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 12px;
  color: var(--muted);
}
.hero-profile__body {
  padding: 18px;
}
.hero-profile__img {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: calc(var(--r-lg) - 4px);
  overflow: hidden;
  background: #040906;
  border: 1px solid rgba(74, 222, 128, 0.18);
}
.hero-profile__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 74% 18%;
  display: block;
  transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
}
.hero-profile:hover .hero-profile__img img {
  transform: scale(1.03);
  filter: saturate(1.12) brightness(1.05);
}
.hero-profile__canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
}
.hero-profile__img::after {
  content: "";
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 0 2px rgba(74, 222, 128, 0.2), inset 0 0 24px rgba(4, 9, 6, 0.55);
  pointer-events: none;
}
.hero-profile__meta {
  padding: 16px 4px 4px;
  display: grid;
  gap: 10px;
}
.hero-profile__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  color: var(--muted);
}
.hero-profile__row strong {
  color: var(--ink);
  font-weight: 500;
}
.hero-profile__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding-top: 4px;
}
.hero-profile__tag {
  font-size: 11px;
  font-weight: 500;
  padding: 4px 9px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(238, 240, 243, 0.1);
  color: var(--ink);
}
@media (max-width: 1023px) {
  .hero__profile-wrap {
    justify-content: flex-start;
    margin-top: var(--s-6);
  }
  .hero-profile {
    max-width: 440px;
  }
}

/* Rows subtitle styling */
.rows .rows__name small {
  display: block;
  font-weight: 400;
  color: var(--muted);
  font-size: var(--t-small);
  margin-top: 2px;
}

/* Diagram & visual panels */
@media (min-width: 1024px) {
  .hero__grid,
  #expertise .grid,
  #projects .grid,
  #articles .grid,
  #manga .grid {
    column-gap: clamp(48px, 6vw, 88px);
    align-items: start;
  }
}
#expertise .panel {
  --p-h: 460px;
  background: #14161b;
  --card: #14161b;
  --bg: #14161b;
  border: 1px solid rgba(238, 240, 243, 0.12);
}
#projects .frame--photo,
#articles .frame--photo {
  height: min(480px, var(--ly-fit, 480px));
  border-radius: var(--r-lg);
  overflow: hidden;
}
#projects .frame--photo {
  background: #ffffff;
  padding: var(--s-4);
}
#projects .frame--photo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}
#articles .frame--photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Project rows inside dark-band */
.rows--inv li {
  border-color: rgba(238, 240, 243, 0.14);
}
.rows--inv .rows__name a {
  color: var(--p-inv-ink);
  text-decoration: none;
}
.rows--inv .rows__name a:hover {
  text-decoration: underline;
}
.rows--inv .rows__name small {
  color: var(--p-inv-muted);
}
.rows--inv .rows__value {
  color: var(--p-inv-muted);
}

/* Compact, vertically centered statement section (avoids 100svh dead space) */
main > .section.statement {
  height: auto;
  min-height: 48svh;
  display: flex;
  align-items: center;
  padding-block: var(--s-10);
}
main > .section.statement > .wrap {
  height: auto;
}

/* Allow content-rich sections to grow cleanly with generous vertical padding */
main > .section:not(.hero, .statement) {
  height: auto;
  min-height: calc(var(--h, 1) * 92svh);
  padding-block: clamp(72px, 8vw, 112px);
}
main > .section:not(.hero, .statement) > .wrap {
  height: auto;
}

/* Live green blinking dot on hero kicker */
.hero__kicker .dot {
  background: #22c55e;
  box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
}
@media (prefers-reduced-motion: no-preference) {
  .hero__kicker .dot {
    animation: kicker-pulse 2s ease-in-out infinite;
  }
}
@keyframes kicker-pulse {
  0%, 100% {
    opacity: 1;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
  }
  50% {
    opacity: 0.45;
    box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
  }
}

/* Glassmorphic float badge over hero portrait */
.hero__media .ly-float {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  background: rgba(17, 19, 24, 0.78);
  border: 1px solid rgba(238, 240, 243, 0.14);
}

/* Native dark-mode Systems & Telemetry UI card in #projects */
.sys-card {
  background: #111317;
  border: 1px solid rgba(238, 240, 243, 0.12);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
}
.sys-card__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid rgba(238, 240, 243, 0.08);
  background: rgba(255, 255, 255, 0.02);
  font-size: 12px;
  color: var(--p-inv-muted);
}
.sys-card__dots {
  display: inline-flex;
  gap: 6px;
  align-items: center;
}
.sys-card__dots i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: rgba(238, 240, 243, 0.18);
  display: block;
}
.sys-card__live {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #4ade80;
  font-weight: 600;
  letter-spacing: 0.04em;
  font-size: 11px;
}
.sys-card__live::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22c55e;
}
.sys-card__body {
  padding: 18px;
  display: grid;
  gap: 12px;
}
.sys-node {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px;
  border-radius: var(--r-md, 10px);
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(238, 240, 243, 0.08);
  transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}
.sys-node:hover {
  transform: translateY(-2px);
  border-color: rgba(59, 87, 255, 0.45);
  background: rgba(59, 87, 255, 0.06);
}
.sys-node__title {
  font-weight: 500;
  color: var(--p-inv-ink);
  font-size: 14px;
}
.sys-node__sub {
  font-size: 12px;
  color: var(--p-inv-muted);
  margin-top: 2px;
}
.sys-node__pill {
  font-size: 11px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(59, 87, 255, 0.16);
  color: #8ea2ff;
  white-space: nowrap;
}
.sys-card__foot {
  padding: 12px 18px;
  border-top: 1px solid rgba(238, 240, 243, 0.08);
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  font-size: 12px;
  color: var(--p-inv-muted);
}

/* Subtle micro-interaction on article rows */
.article-row {
  transition: transform 0.18s ease, border-color 0.18s ease;
}
.article-row:hover {
  transform: translateX(4px);
}

/* Playful 8-bit Super Mario interactive badge */
.mario-pixel-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  margin-left: 8px;
  vertical-align: middle;
  background: transparent;
  border: 0;
  cursor: pointer;
  transition: transform 0.15s ease;
}
.mario-pixel-btn:hover {
  transform: translateY(-2px) scale(1.08);
}
.mario-pixel-btn:active {
  transform: translateY(1px) scale(0.95);
}
@media (prefers-reduced-motion: no-preference) {
  .mario-pixel-btn svg {
    animation: mario-bob 2.2s ease-in-out infinite;
  }
}
@keyframes mario-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}
.mario-1up {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 700;
  color: #4ade80;
  pointer-events: none;
  white-space: nowrap;
  animation: mario-pop 0.75s ease-out forwards;
}
@keyframes mario-pop {
  0% { opacity: 1; transform: translate(-50%, 0); }
  100% { opacity: 0; transform: translate(-50%, -18px); }
}
.approach-quote {
  margin-top: var(--s-5);
  font-size: var(--t-small);
  color: var(--muted);
  font-style: italic;
}
.hero-socials {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: var(--s-5);
}
.hero-social {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 13px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  color: #eef0f3;
  text-decoration: none;
  background: var(--social-bg, rgba(255, 255, 255, 0.06));
  border: 1px solid var(--social-border, rgba(238, 240, 243, 0.14));
  transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
}
.hero-social svg {
  width: 14px;
  height: 14px;
  flex: none;
  display: block;
}
.hero-social:hover {
  transform: translateY(-2px);
  filter: brightness(1.12);
  box-shadow: 0 6px 18px var(--social-glow, rgba(59, 87, 255, 0.22));
}
.hero-social--github {
  --social-bg: rgba(110, 118, 129, 0.18);
  --social-border: rgba(238, 240, 243, 0.22);
  --social-glow: rgba(238, 240, 243, 0.14);
}
.hero-social--linkedin {
  --social-bg: rgba(10, 102, 194, 0.22);
  --social-border: rgba(56, 152, 236, 0.42);
  --social-glow: rgba(10, 102, 194, 0.35);
}
.hero-social--twitter {
  --social-bg: rgba(29, 155, 240, 0.18);
  --social-border: rgba(29, 155, 240, 0.42);
  --social-glow: rgba(29, 155, 240, 0.32);
}
.hero-social--instagram {
  --social-bg: rgba(228, 64, 95, 0.2);
  --social-border: rgba(228, 64, 95, 0.44);
  --social-glow: rgba(228, 64, 95, 0.34);
}
.hero-social--facebook {
  --social-bg: rgba(24, 119, 242, 0.22);
  --social-border: rgba(59, 130, 246, 0.44);
  --social-glow: rgba(24, 119, 242, 0.35);
}
.hero-social--reddit {
  --social-bg: rgba(255, 69, 0, 0.2);
  --social-border: rgba(255, 87, 34, 0.45);
  --social-glow: rgba(255, 69, 0, 0.34);
}

/* Manga channel rows with brand icons & colors */
.manga-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}
.manga-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 7px;
  flex: none;
}
.manga-icon svg {
  width: 15px;
  height: 15px;
  display: block;
}
.manga-icon--telegram {
  background: rgba(38, 165, 228, 0.2);
  border: 1px solid rgba(38, 165, 228, 0.42);
  color: #5bc0f8;
}
.manga-icon--youtube {
  background: rgba(255, 0, 51, 0.2);
  border: 1px solid rgba(255, 68, 88, 0.44);
  color: #ff5c6c;
}
.manga-icon--reddit {
  background: rgba(255, 69, 0, 0.2);
  border: 1px solid rgba(255, 87, 34, 0.44);
  color: #ff7043;
}
.manga-pill {
  display: inline-flex;
  align-items: center;
  align-self: center;
  height: fit-content;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.2;
  padding: 5px 11px;
  border-radius: 999px;
  white-space: nowrap;
}
.manga-pill--telegram {
  background: rgba(38, 165, 228, 0.16);
  color: #5bc0f8;
  border: 1px solid rgba(38, 165, 228, 0.3);
}
.manga-pill--youtube {
  background: rgba(255, 0, 51, 0.16);
  color: #ff6b7a;
  border: 1px solid rgba(255, 68, 88, 0.3);
}
.manga-pill--reddit {
  background: rgba(255, 69, 0, 0.16);
  color: #ff7a52;
  border: 1px solid rgba(255, 87, 34, 0.3);
}

/* Animated 8-bit Super Mario Mushroom logo */
.mark--mario {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  flex: none;
}
.footer .nav__logo .mark--mario {
  width: 24px;
  height: 24px;
}
.mark--mario svg {
  width: 100%;
  height: 100%;
  display: block;
}
@media (prefers-reduced-motion: no-preference) {
  .mark--mario svg {
    animation: mario-idle 1.4s ease-in-out infinite;
    transform-origin: center bottom;
  }
  .nav__logo:hover .mark--mario svg {
    animation: mario-hop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
}
@keyframes mario-idle {
  0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
  35% { transform: translateY(-4px) rotate(-4deg) scale(1.06); }
  70% { transform: translateY(-2px) rotate(4deg) scale(1.03); }
}
@keyframes mario-hop {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-6px) scale(1.14); }
}

/* Playful arcade 3D primary CTA buttons with animated 8-bit Star */
.btn--primary {
  box-shadow: 0 4px 0 #1e32a8, 0 10px 24px rgba(59, 87, 255, 0.28);
  transition: transform 0.14s ease, box-shadow 0.14s ease, background-color 0.15s ease;
}
.btn--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 0 #1e32a8, 0 14px 28px rgba(59, 87, 255, 0.38);
}
.btn--primary:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 #1e32a8, 0 4px 12px rgba(59, 87, 255, 0.24);
}
.mario-star-icon {
  width: 18px;
  height: 18px;
  flex: none;
  display: inline-block;
}
@media (prefers-reduced-motion: no-preference) {
  .mario-star-icon {
    animation: star-pulse 1.6s ease-in-out infinite;
  }
  .btn--primary:hover .mario-star-icon {
    animation: star-hop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
}
@keyframes star-pulse {
  0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
  50% { transform: translateY(-2px) rotate(6deg) scale(1.1); }
}
@keyframes star-hop {
  0%, 100% { transform: translateY(0) rotate(-6deg) scale(1.05); }
  50% { transform: translateY(-4px) rotate(8deg) scale(1.18); }
}

/* Footer contact form (Web3Forms) */
footer.closing {
  height: auto;
  min-height: 0;
}
.closing__cta--form {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--s-7);
  align-items: start;
}
@media (min-width: 1024px) {
  .closing__cta--form {
    grid-template-columns: 5fr 7fr;
    gap: clamp(40px, 6vw, 88px);
  }
}
.contact-form {
  background: #14161b;
  border: 1px solid rgba(238, 240, 243, 0.12);
  border-radius: var(--r-lg);
  padding: 24px;
  display: grid;
  gap: 14px;
}
.contact-form__row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
}
@media (min-width: 640px) {
  .contact-form__row {
    grid-template-columns: 1fr 1fr;
  }
}
.contact-form__field {
  display: grid;
  gap: 6px;
}
.contact-form__field label {
  font-size: 12px;
  font-weight: 500;
  color: var(--muted);
}
.contact-form__field input,
.contact-form__field textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 11px 14px;
  border-radius: var(--r-sm, 8px);
  border: 1px solid rgba(238, 240, 243, 0.14);
  background: #0b0c0e;
  color: var(--ink);
  font-family: inherit;
  font-size: 14px;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.contact-form__field textarea {
  min-height: 104px;
  resize: vertical;
}
.contact-form__field input:focus,
.contact-form__field textarea:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(59, 87, 255, 0.22);
}
.contact-form__foot {
  display: flex;
  flex-wrap: wrap;
